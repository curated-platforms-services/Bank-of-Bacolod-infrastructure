    "app/(tabs)/categories.tsx": """import { useMemo, useState } from "react";
import { Pressable, Text, TextInput, View } from "react-native";
import Screen from "../../src/components/Screen";
import SectionTitle from "../../src/components/SectionTitle";
import ServiceCard from "../../src/components/ServiceCard";
import LoadingState from "../../src/components/LoadingState";
import EmptyState from "../../src/components/EmptyState";
import { useCatalog } from "../../src/hooks/useCatalog";
import { colors } from "../../src/theme/colors";

const tabs = ["All", "Business Services", "Cloud Services", "AI Agents", "Environments"];

export default function CategoriesScreen() {
  const { data, loading } = useCatalog();
  const [query, setQuery] = useState("");
  const [selected, setSelected] = useState("All");

  const filtered = useMemo(() => {
    return data.filter((item) => {
      const matchesCategory = selected === "All" || item.category === selected;
      const q = query.toLowerCase();
      const matchesQuery =
        item.name.toLowerCase().includes(q) ||
        item.provider.toLowerCase().includes(q) ||
        item.region.toLowerCase().includes(q);
      return matchesCategory && matchesQuery;
    });
  }, [data, query, selected]);

  return (
    <Screen>
      <SectionTitle title="Category Explorer" subtitle="Browse curated catalog items by category." />

      <TextInput
        value={query}
        onChangeText={setQuery}
        placeholder="Search by service, provider, region..."
        style={{
          borderWidth: 1,
          borderColor: colors.border,
          backgroundColor: colors.surface,
          borderRadius: 12,
          paddingHorizontal: 14,
          paddingVertical: 12,
          marginBottom: 14
        }}
      />

      <View style={{ flexDirection: "row", flexWrap: "wrap", gap: 8, marginBottom: 14 }}>
        {tabs.map((tab) => (
          <Pressable
            key={tab}
            onPress={() => setSelected(tab)}
            style={{
              paddingHorizontal: 14,
              paddingVertical: 10,
              borderRadius: 999,
              backgroundColor: selected === tab ? colors.primary : colors.surface,
              borderWidth: 1,
              borderColor: selected === tab ? colors.primary : colors.border
            }}
          >
            <Text style={{ color: selected === tab ? "#fff" : colors.text, fontWeight: "600" }}>{tab}</Text>
          </Pressable>
        ))}
      </View>

      <Text style={{ marginBottom: 14, color: colors.muted }}>{filtered.length} results found</Text>

      {loading ? (
        <LoadingState />
      ) : filtered.length === 0 ? (
        <EmptyState message="No services matched your search." />
      ) : (
        filtered.map((item) => <ServiceCard key={item.id} item={item} />)
      )}
    </Screen>
  );
}

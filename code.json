  return (
    <Screen>
      <SectionTitle title="Sign In" subtitle="Access the Bank of Bacolod service catalog." />
      <AppInput label="Email" value={email} onChangeText={setEmail} autoCapitalize="none" />
      <AppInput label="Password" value={password} onChangeText={setPassword} secureTextEntry />
      <AppButton title="Sign In" onPress={onSubmit} />
      <Text style={{ marginTop: 16 }}>
        No account? <Link href="/(auth)/sign-up">Create one</Link>
      </Text>
    </Screen>
  );
}

export default function SignInScreen() {
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");

  const onSubmit = async () => {
    const { error } = await signIn(email, password);
    if (error) {
      Alert.alert("Sign In Failed", error.message);

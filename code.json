    "app/(auth)/sign-up.tsx": """import { useState } from "react";
import { Alert, Text } from "react-native";
import { Link } from "expo-router";
import Screen from "../../src/components/Screen";
import SectionTitle from "../../src/components/SectionTitle";
import AppInput from "../../src/components/AppInput";
import AppButton from "../../src/components/AppButton";
import { signUp } from "../../src/services/authService";

export default function SignUpScreen() {
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");

  const onSubmit = async () => {
    const { error } = await signUp(email, password);
    if (error) {
      Alert.alert("Sign Up Failed", error.message);
      return;
    }
    Alert.alert("Success", "Account created. Please verify your email if required.");
  };

  return (
    <Screen>
      <SectionTitle title="Create Account" subtitle="Register to submit and track service inquiries." />
      <AppInput label="Email" value={email} onChangeText={setEmail} autoCapitalize="none" />
      <AppInput label="Password" value={password} onChangeText={setPassword} secureTextEntry />
      <AppButton title="Create Account" onPress={onSubmit} />
      <Text style={{ marginTop: 16 }}>
        Already have an account? <Link href="/(auth)/sign-in">Sign in</Link>
      </Text>
    </Screen>
  );
}
